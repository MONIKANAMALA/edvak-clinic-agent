PORT=3000
HOST=localhost
CLINIC_TODAY=2026-11-09

# LLM Provider Configuration
# Option 1: In-Process Local Hugging Face AI Model (Recommended! No API key, No Rate limits, Runs 100% Offline)
LLM_PROVIDER=local
LOCAL_MODEL=Xenova/all-MiniLM-L6-v2

# Option 2: Deterministic Baseline Engine
# LLM_PROVIDER=deterministic

# Option 3: Local Ollama Model (e.g. ollama run llama3.2:1b)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:1b
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions

# Option 4: Mistral AI API (Note: Free tier has strict 1-call/sec rate limits)
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=your_mistral_api_key_here
# LLM_MODEL=mistral-small-latest

ALLOW_DETERMINISTIC_FALLBACK=true
